# Copie para .env e preencha com os valores reais (NUNCA commitar o .env)

# --- GCP ---
GOOGLE_APPLICATION_CREDENTIALS=/caminho/local/para/sa-candidato-ae-diego.json
GCP_PROJECT_ID=vena-teste
BQ_DATASET=teste_tecnico_ae_diego
GCS_BUCKET=vena-teste-candidato-ae-diego
GCP_REGION=southamerica-east1

# --- Fonte 1: API de vendas ---
API_VENDAS_BASE_URL=https://api-vendas-teste-vyi7ppqsoq-rj.a.run.app
API_VENDAS_TOKEN=vena-teste-2026
API_VENDAS_PAGE_SIZE=500

# --- Fonte 2: Scraping de concorrentes ---
SCRAPING_URL=https://scraping-precos-teste-vyi7ppqsoq-rj.a.run.app/concorrentes/precos

# --- Fonte 3: Banco transacional ---
# Caminho local do arquivo .sqlite fornecido (não versionado — ver .gitignore)
SQLITE_DB_PATH=./data/banco_transacional.sqlite

# --- Execução ---
SQLITE_CHUNK_SIZE=100000
LOG_LEVEL=INFO
